# Optional: enables external LLM-generated wording. Leave blank for the free local RAG mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required for a public/production deployment. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Required only when using a managed MongoDB deployment.
MONGODB_URI=mongodb://mongodb:27017/skillforge
